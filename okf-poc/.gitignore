# Python bytecode, tooling, and local environments
__pycache__/
*.py[cod]
*.class
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.coverage
/htmlcov/
/.venv/
/.venv-eval/
/venv/
/ENV/

# Local environment and credentials
/.env
/.env.*
!/.env.example
/credentials/*
!/credentials/.gitkeep

# Disposable crawler cache, uploads, and job/sync state
/cache/*
!/cache/.gitkeep

# knowledge/ is the source of truth (generated OKF Markdown) - it MUST be committed,
# so do not ignore it.

# Local migration/cleanup backups
/backups/

# Local Qdrant vector storage (bind-mounted by docker-compose.yml)
/qdrant_storage/

# Jupyter-generated state
.ipynb_checkpoints/

# Editors and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
