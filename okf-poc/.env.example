# =========================================================
# AI PROVIDER
# =========================================================

# Options:
# gemini
# vertex
AI_PROVIDER=vertex


# =========================================================
# GEMINI DEVELOPER API
# =========================================================

GEMINI_API_KEY=your_gemini_api_key_here

LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-2


# =========================================================
# VERTEX AI
# =========================================================

VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=global

VERTEX_LLM_MODEL=gemini-3.5-flash
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
# Short-lived OAuth access token, for local development only. Generate it from
# your service-account authentication and replace the placeholder below.
VERTEX_ACCESS_TOKEN=your_vertex_access_token_here

# Authentication uses Application Default Credentials (ADC). For a service
# account, either configure the runtime identity or optionally uncomment this:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json


# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_CONCEPTS_COLLECTION=okf_concepts

# FastAPI
API_HOST=http://api:8000
API_PORT=8000

# RAG Configuration
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# Generation
TEMPERATURE=0.1

# LLM resilience: retry Gemini calls on 429 quota/rate-limit errors.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=3
# Per-call timeout for Gemini REST calls (prevents 60s+ stalls).
LLM_TIMEOUT_SECONDS=30

# Storage Paths
# Cache: disposable data (crawled HTML, processing state, uploaded raw files)
CACHE_DIR=cache

# Knowledge: source of truth (generated OKF Markdown files with frontmatter)
KNOWLEDGE_DIR=knowledge

# Sources configuration
SOURCES_CONFIG=config/sources.yaml

# Environment
ENV=development
LOG_LEVEL=INFO
