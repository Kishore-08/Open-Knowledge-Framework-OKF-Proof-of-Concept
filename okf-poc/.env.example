# Gemini
# Get a free API key at https://aistudio.google.com/apikey
# The llama-index Gemini integration also reads GOOGLE_API_KEY, so either one works,
# but GEMINI_API_KEY is preferred for this project.
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_CONCEPTS_COLLECTION=okf_concepts

# FastAPI
API_HOST=http://api:8000
API_PORT=8000

# Models
# gemini-flash-lite-latest: larger free-tier quota, verified working for fresh keys.
# gemini-3.5-flash also works but the free-tier quota for it is very tight
# (20 requests/day for fresh keys), which quickly exhausts during testing.
LLM_MODEL=gemini-flash-lite-latest
# If LLM_MODEL fails (400 unknown model / 429 quota), fall back to this model.
LLM_FALLBACK_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=models/gemini-embedding-001

# RAG Configuration
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# Generation
TEMPERATURE=0.1

# LLM resilience: retry Gemini calls on 429 quota/rate-limit errors.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=3
# Per-call timeout for Gemini REST calls (prevents 60s+ stalls).
LLM_TIMEOUT_SECONDS=30

# Storage Paths
# Cache: disposable data (crawled HTML, processing state, uploaded raw files)
CACHE_DIR=cache

# Knowledge: source of truth (generated OKF Markdown files with frontmatter)
KNOWLEDGE_DIR=knowledge

# Sources configuration
SOURCES_CONFIG=config/sources.yaml

# Environment
ENV=development
LOG_LEVEL=INFO
